+    /// Parse all requested replay ticks once and write one Parquet row group per round.
+    #[pyo3(signature = (output_path, wanted_props, ticks, round_numbers))]
+    pub fn write_replay_parquet(
+        &self,
+        py: Python<'_>,
+        output_path: String,
+        wanted_props: Vec<String>,
+        ticks: Vec<i32>,
+        round_numbers: Vec<i32>,
+    ) -> PyResult<Py<PyAny>> {
+        if ticks.is_empty() || ticks.len() != round_numbers.len() {
+            return Err(PyValueError::new_err(
+                "ticks and round_numbers must be non-empty lists with identical lengths",
+            ));
+        }
+        let real_props = rm_user_friendly_names(&wanted_props)
+            .map_err(|error| Exception::new_err(format!("{error}")))?;
+        let arc_huf = Arc::new(&self.huf);
+        let mut real_name_to_og_name = AHashMap::default();
+        for (real_name, user_friendly_name) in real_props.iter().zip(&wanted_props) {
+            real_name_to_og_name.insert(real_name.clone(), user_friendly_name.clone());
+        }
+        let settings = ParserInputs {
+            real_name_to_og_name,
+            wanted_players: vec![],
+            wanted_player_props: real_props,
+            wanted_other_props: vec![],
+            wanted_events: vec![],
+            wanted_prop_states: AHashMap::default(),
+            parse_ents: true,
+            wanted_ticks: ticks.clone(),
+            parse_projectiles: false,
+            parse_grenades: false,
+            parse_infernos: false,
+            only_header: true,
+            list_props: false,
+            only_convars: false,
+            huffman_lookup_table: &arc_huf,
+            order_by_steamid: false,
+            fallback_bytes: None,
+        };
+        let mut parser = Parser::new(settings, parser::parse_demo::ParsingMode::Normal);
+        let output = parser
+            .parse_demo(&self.mmap)
+            .map_err(|error| Exception::new_err(format!("{error}")))?;
+
+        let tick_to_round: AHashMap<i32, i32> = ticks.into_iter().zip(round_numbers).collect();
+        let tick_values = match output
+            .df
+            .get(&TICK_ID)
+            .and_then(|column| column.data.as_ref())
+        {
+            Some(VarVec::I32(values)) => values,
+            _ => {
+                return Err(Exception::new_err(
+                    "replay parse did not return an int32 tick column",
+                ))
+            }
+        };
+        let mut indices_by_round: BTreeMap<i32, Vec<usize>> = BTreeMap::new();
+        for (index, tick) in tick_values.iter().enumerate() {
+            if let Some(round_number) = tick.and_then(|value| tick_to_round.get(&value).copied()) {
+                indices_by_round
+                    .entry(round_number)
+                    .or_default()
+                    .push(index);
+            }
+        }
+        if indices_by_round.is_empty() {
+            return Err(Exception::new_err(
+                "replay parse returned no rows for requested ticks",
+            ));
+        }
+
+        let properties = WriterProperties::builder()
+            .set_compression(Compression::ZSTD(Default::default()))
+            .set_dictionary_enabled(true)
+            .build();
+        let replay_columns: Vec<(String, &VarVec)> = output
+            .prop_controller
+            .prop_infos
+            .iter()
+            .filter_map(|prop_info| {
+                output
+                    .df
+                    .get(&prop_info.id)
+                    .and_then(|column| column.data.as_ref())
+                    .map(|data| (prop_info.prop_friendly_name.clone(), data))
+            })
+            .collect();
+        let mut fields = vec![Arc::new(
+            ParquetType::primitive_type_builder("round_number", PhysicalType::INT32)
+                .with_repetition(Repetition::REQUIRED)
+                .build()
+                .map_err(|error| {
+                    Exception::new_err(format!("build replay round schema failed: {error}"))
+                })?,
+        )];
+        for (name, data) in &replay_columns {
+            fields.push(Arc::new(
+                replay_parquet_field(name, data).map_err(Exception::new_err)?,
+            ));
+        }
+        let schema = Arc::new(
+            ParquetType::group_type_builder("replay")
+                .with_fields(fields)
+                .build()
+                .map_err(|error| {
+                    Exception::new_err(format!("build replay parquet schema failed: {error}"))
+                })?,
+        );
+        let file = File::create(&output_path).map_err(|error| {
+            Exception::new_err(format!("create replay parquet failed: {error}"))
+        })?;
+        let mut writer =
+            SerializedFileWriter::new(file, schema, Arc::new(properties)).map_err(|error| {
+                Exception::new_err(format!("open replay parquet writer failed: {error}"))
+            })?;
+        let mut row_groups: Vec<Bound<'_, PyDict>> = vec![];
+
+        for (row_group_index, (round_number, indices)) in indices_by_round.iter().enumerate() {
+            let mut row_group_writer = writer.next_row_group().map_err(|error| {
+                Exception::new_err(format!("open replay row group failed: {error}"))
+            })?;
+            let mut round_column = row_group_writer
+                .next_column()
+                .map_err(|error| {
+                    Exception::new_err(format!("open replay round column failed: {error}"))
+                })?
+                .ok_or_else(|| Exception::new_err("missing replay round column writer"))?;
+            round_column
+                .typed::<Int32Type>()
+                .write_batch(&vec![*round_number; indices.len()], None, None)
+                .map_err(|error| {
+                    Exception::new_err(format!("write replay round column failed: {error}"))
+                })?;
+            round_column.close().map_err(|error| {
+                Exception::new_err(format!("close replay round column failed: {error}"))
+            })?;
+
+            for (name, data) in &replay_columns {
+                let mut column_writer = row_group_writer
+                    .next_column()
+                    .map_err(|error| {
+                        Exception::new_err(format!(
+                            "open replay parquet column {name} failed: {error}"
+                        ))
+                    })?
+                    .ok_or_else(|| {
+                        Exception::new_err(format!(
+                            "missing replay parquet column writer for {name}"
+                        ))
+                    })?;
+                replay_parquet_write_column(&mut column_writer, data, indices).map_err(
+                    |error| {
+                        Exception::new_err(format!(
+                            "write replay parquet column {name} failed: {error}"
+                        ))
+                    },
+                )?;
+                column_writer.close().map_err(|error| {
+                    Exception::new_err(format!(
+                        "close replay parquet column {name} failed: {error}"
+                    ))
+                })?;
+            }
+            if row_group_writer
+                .next_column()
+                .map_err(|error| {
+                    Exception::new_err(format!("finish replay row group failed: {error}"))
+                })?
+                .is_some()
+            {
+                return Err(Exception::new_err(
+                    "replay parquet schema has an unexpected extra column",
+                ));
+            }
+            row_group_writer.close().map_err(|error| {
+                Exception::new_err(format!("close replay row group failed: {error}"))
+            })?;
