+fn demo_output_dataframe(py: Python<'_>, output: &DemoOutput) -> PyResult<Py<PyAny>> {
+    let mut columns = vec![];
+    let mut arrow_names = vec![];
+    let mut object_names = vec![];
+    let mut object_columns = vec![];
+
+    for prop_info in &output.prop_controller.prop_infos {
+        let Some(column) = output.df.get(&prop_info.id) else {
+            continue;
+        };
+        match &column.data {
+            Some(VarVec::F32(data)) => {
+                arrow_names.push(prop_info.prop_friendly_name.clone());
+                columns.push(data.into_py_any(py)?);
+            }
+            Some(VarVec::I32(data)) => {
+                arrow_names.push(prop_info.prop_friendly_name.clone());
+                columns.push(data.into_py_any(py)?);
+            }
+            Some(VarVec::U64(data)) => {
+                arrow_names.push(prop_info.prop_friendly_name.clone());
+                columns.push(data.into_py_any(py)?);
+            }
+            Some(VarVec::U32(data)) => {
+                arrow_names.push(prop_info.prop_friendly_name.clone());
+                columns.push(data.into_py_any(py)?);
+            }
+            Some(VarVec::Bool(data)) => {
+                arrow_names.push(prop_info.prop_friendly_name.clone());
+                columns.push(data.into_py_any(py)?);
+            }
+            Some(VarVec::String(data)) => {
+                arrow_names.push(prop_info.prop_friendly_name.clone());
+                columns.push(data.into_py_any(py)?);
+            }
+            Some(VarVec::StringVec(data)) => {
+                object_names.push(prop_info.prop_friendly_name.clone());
+                object_columns.push(data.into_py_any(py)?);
+            }
+            Some(VarVec::U64Vec(data)) => {
+                object_names.push(prop_info.prop_friendly_name.clone());
+                object_columns.push(data.into_py_any(py)?);
+            }
+            Some(VarVec::XYZVec(data)) => {
+                object_names.push(prop_info.prop_friendly_name.clone());
+                object_columns.push(data.into_py_any(py)?);
+            }
+            Some(VarVec::U32Vec(data)) => {
+                object_names.push(prop_info.prop_friendly_name.clone());
+                object_columns.push(data.into_py_any(py)?);
+            }
+            Some(VarVec::U8Vec(data)) => {
+                object_names.push(prop_info.prop_friendly_name.clone());
+                let py_list = PyList::empty(py);
+                for bytes in data {
+                    match bytes {
+                        Some(bytes) => py_list.append(PyBytes::new(py, bytes))?,
+                        None => py_list.append(py.None())?,
+                    }
+                }
+                object_columns.push(py_list.into_py_any(py)?);
+            }
+            Some(VarVec::BoolVec(data)) => {
+                object_names.push(prop_info.prop_friendly_name.clone());
+                object_columns.push(data.into_py_any(py)?);
+            }
+            Some(VarVec::VecXYZList(data)) => {
+                object_names.push(prop_info.prop_friendly_name.clone());
+                object_columns.push(data.into_py_any(py)?);
+            }
+            _ => {}
