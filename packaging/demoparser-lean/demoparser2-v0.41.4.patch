+fn replay_parquet_field(name: &str, data: &VarVec) -> Result<ParquetType, String> {
+    let (physical_type, converted_type) = match data {
+        VarVec::Bool(_) => (PhysicalType::BOOLEAN, ConvertedType::NONE),
+        VarVec::I32(_) => (PhysicalType::INT32, ConvertedType::NONE),
+        VarVec::F32(_) => (PhysicalType::FLOAT, ConvertedType::NONE),
+        VarVec::U32(_) => (PhysicalType::INT32, ConvertedType::UINT_32),
+        VarVec::U64(_) => (PhysicalType::INT64, ConvertedType::UINT_64),
+        VarVec::String(_) | VarVec::StringVec(_) => (PhysicalType::BYTE_ARRAY, ConvertedType::UTF8),
+        other => return Err(format!("unsupported replay parquet column type: {other:?}")),
+    };
+    ParquetType::primitive_type_builder(name, physical_type)
+        .with_repetition(Repetition::OPTIONAL)
+        .with_converted_type(converted_type)
+        .build()
+        .map_err(|error| error.to_string())
+}
+
+fn replay_parquet_write_column(
+    column: &mut SerializedColumnWriter<'_>,
+    data: &VarVec,
+    indices: &[usize],
+) -> Result<(), String> {
+    match data {
+        VarVec::Bool(source) => {
+            let mut values = Vec::with_capacity(indices.len());
+            let mut definitions = Vec::with_capacity(indices.len());
+            for index in indices {
+                match source[*index] {
+                    Some(value) => {
+                        definitions.push(1);
+                        values.push(value);
+                    }
+                    None => definitions.push(0),
+                }
+            }
+            column
+                .typed::<BoolType>()
+                .write_batch(&values, Some(&definitions), None)
+                .map_err(|error| error.to_string())?;
+        }
+        VarVec::I32(source) => {
+            let mut values = Vec::with_capacity(indices.len());
+            let mut definitions = Vec::with_capacity(indices.len());
+            for index in indices {
+                match source[*index] {
+                    Some(value) => {
+                        definitions.push(1);
+                        values.push(value);
+                    }
+                    None => definitions.push(0),
+                }
+            }
+            column
+                .typed::<Int32Type>()
+                .write_batch(&values, Some(&definitions), None)
+                .map_err(|error| error.to_string())?;
+        }
+        VarVec::F32(source) => {
+            let mut values = Vec::with_capacity(indices.len());
+            let mut definitions = Vec::with_capacity(indices.len());
+            for index in indices {
+                match source[*index] {
+                    Some(value) => {
+                        definitions.push(1);
+                        values.push(value);
+                    }
+                    None => definitions.push(0),
+                }
+            }
+            column
+                .typed::<FloatType>()
+                .write_batch(&values, Some(&definitions), None)
+                .map_err(|error| error.to_string())?;
+        }
+        VarVec::U32(source) => {
+            let mut values = Vec::with_capacity(indices.len());
+            let mut definitions = Vec::with_capacity(indices.len());
+            for index in indices {
+                match source[*index] {
+                    Some(value) => {
+                        definitions.push(1);
+                        values.push(value as i32);
+                    }
+                    None => definitions.push(0),
+                }
+            }
+            column
+                .typed::<Int32Type>()
+                .write_batch(&values, Some(&definitions), None)
+                .map_err(|error| error.to_string())?;
+        }
+        VarVec::U64(source) => {
+            let mut values = Vec::with_capacity(indices.len());
+            let mut definitions = Vec::with_capacity(indices.len());
+            for index in indices {
+                match source[*index] {
+                    Some(value) => {
+                        definitions.push(1);
+                        values.push(value as i64);
+                    }
+                    None => definitions.push(0),
+                }
+            }
+            column
+                .typed::<Int64Type>()
+                .write_batch(&values, Some(&definitions), None)
+                .map_err(|error| error.to_string())?;
+        }
+        VarVec::String(source) => {
+            let mut values = Vec::with_capacity(indices.len());
+            let mut definitions = Vec::with_capacity(indices.len());
+            for index in indices {
+                match source[*index].as_deref() {
+                    Some(value) => {
+                        definitions.push(1);
+                        values.push(ByteArray::from(value));
+                    }
+                    None => definitions.push(0),
+                }
+            }
+            column
+                .typed::<ByteArrayType>()
+                .write_batch(&values, Some(&definitions), None)
+                .map_err(|error| error.to_string())?;
+        }
+        // Repeated inventory strings dominate the replay payload. Store the compact
+        // JSON representation as a dictionary-compressible UTF-8 Parquet column.
+        VarVec::StringVec(source) => {
+            let values: Result<Vec<ByteArray>, String> = indices
+                .iter()
+                .map(|index| {
+                    serde_json::to_string(&source[*index])
+                        .map(|value| ByteArray::from(value.as_str()))
+                        .map_err(|error| error.to_string())
+                })
+                .collect();
+            let definitions = vec![1; indices.len()];
+            column
+                .typed::<ByteArrayType>()
+                .write_batch(&values?, Some(&definitions), None)
+                .map_err(|error| error.to_string())?;
+        }
+        other => return Err(format!("unsupported replay parquet column type: {other:?}")),
+    }
+    Ok(())
+}
