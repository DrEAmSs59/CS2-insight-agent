+impl Entity {
+    pub fn weapon_econ_attribute_length(&self) -> Option<usize> {
+        self.vector_lengths
+            .iter()
+            .filter_map(|(info, length)| {
+                (info.element_kind == VectorElementKind::WeaponEconAttribute).then_some(*length)
+            })
+            .min()
+    }
+
+    fn update_vector_length(&mut self, info: VectorRootInfo, new_length: usize) {
+        let new_length = new_length.min(FLATTENED_VEC_MAX_LEN as usize);
+        let old_length = self.vector_lengths.insert(info, new_length);
+        let mut removed_any = false;
+        if let Some(old_length) = old_length {
+            if new_length < old_length {
+                for index in new_length..old_length {
+                    let Ok(index) = u32::try_from(index) else {
+                        break;
+                    };
+                    match info.element_kind {
+                        VectorElementKind::WeaponEconAttribute => {
+                            removed_any |= self.props.remove(&(WEAPON_ATTRIBUTE_DEF_INDEX_ID + index)).is_some();
+                            removed_any |= self.props.remove(&(WEAPON_SKIN_ID + index)).is_some();
+                        }
+                    }
+                }
+            }
+        }
+        if old_length != Some(new_length) || removed_any {
+            self.cosmetic_revision = self.cosmetic_revision.wrapping_add(1);
+        }
+    }
+
+    fn is_weapon_econ_property(prop_id: u32) -> bool {
+        (WEAPON_ATTRIBUTE_DEF_INDEX_ID..WEAPON_ATTRIBUTE_DEF_INDEX_ID + FLATTENED_VEC_MAX_LEN)
+            .contains(&prop_id)
+            || (WEAPON_SKIN_ID..WEAPON_SKIN_ID + FLATTENED_VEC_MAX_LEN).contains(&prop_id)
+    }
+}
