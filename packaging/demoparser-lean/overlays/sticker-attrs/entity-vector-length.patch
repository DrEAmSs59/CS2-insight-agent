+#[cfg(test)]
+mod econ_vector_tests {
+    use super::*;
+    use crate::first_pass::sendtables::VectorId;
+
+    const ECON_VECTOR_INFO: VectorRootInfo = VectorRootInfo {
+        vector_id: VectorId {
+            path: [4, 0, 0, 0, 0, 0, 0],
+            last: 0,
+        },
+        element_kind: VectorElementKind::WeaponEconAttribute,
+    };
+
+    fn entity(entity_id: i32) -> Entity {
+        Entity {
+            cls_id: 1,
+            entity_id,
+            props: AHashMap::new(),
+            vector_lengths: AHashMap::new(),
+            cosmetic_revision: 0,
+            entity_type: EntityType::Normal,
+        }
+    }
+
+    fn apply_length(entity: &mut Entity, length: u32) {
+        SecondPassParser::insert_resolved_field(
+            entity,
+            Variant::U32(length),
+            Some(ResolvedField::VectorLength(ECON_VECTOR_INFO)),
+        );
+    }
+
+    fn put_slot(entity: &mut Entity, index: u32, definition: u32, raw: f32) {
+        entity
+            .props
+            .insert(WEAPON_ATTRIBUTE_DEF_INDEX_ID + index, Variant::U32(definition));
+        entity
+            .props
+            .insert(WEAPON_SKIN_ID + index, Variant::F32(raw));
+    }
+
+    fn assert_slot_absent(entity: &Entity, index: u32) {
+        assert!(!entity.props.contains_key(&(WEAPON_ATTRIBUTE_DEF_INDEX_ID + index)));
+        assert!(!entity.props.contains_key(&(WEAPON_SKIN_ID + index)));
+    }
+
+    #[test]
+    fn econ_vector_shrinks_from_11_to_3_without_baseline_tail() {
+        let mut entity = entity(1);
+        apply_length(&mut entity, 11);
+        for index in 0..11 {
+            put_slot(&mut entity, index, 100 + index, index as f32);
+        }
+
+        apply_length(&mut entity, 3);
+        for index in 0..3 {
+            put_slot(&mut entity, index, 200 + index, 20.0 + index as f32);
+        }
+
+        assert_eq!(entity.weapon_econ_attribute_length(), Some(3));
+        for index in 0..3 {
+            assert_eq!(
+                entity.props.get(&(WEAPON_ATTRIBUTE_DEF_INDEX_ID + index)),
+                Some(&Variant::U32(200 + index))
+            );
+        }
+        for index in 3..11 {
+            assert_slot_absent(&entity, index);
+        }
+    }
+
+    #[test]
+    fn econ_vector_equal_length_preserves_valid_baseline_slots() {
+        let mut entity = entity(1);
+        apply_length(&mut entity, 5);
+        for index in 0..5 {
+            put_slot(&mut entity, index, 100 + index, index as f32);
+        }
+
+        apply_length(&mut entity, 5);
+        put_slot(&mut entity, 0, 200, 20.0);
+
+        assert_eq!(
+            entity.props.get(&WEAPON_ATTRIBUTE_DEF_INDEX_ID),
+            Some(&Variant::U32(200))
+        );
+        for index in 1..5 {
+            assert_eq!(
+                entity.props.get(&(WEAPON_ATTRIBUTE_DEF_INDEX_ID + index)),
+                Some(&Variant::U32(100 + index))
+            );
+        }
+    }
+
+    #[test]
+    fn econ_vector_shrinks_to_zero() {
+        let mut entity = entity(1);
+        apply_length(&mut entity, 5);
+        for index in 0..5 {
+            put_slot(&mut entity, index, 100 + index, index as f32);
+        }
+
+        apply_length(&mut entity, 0);
+
+        assert_eq!(entity.weapon_econ_attribute_length(), Some(0));
+        for index in 0..5 {
+            assert_slot_absent(&entity, index);
+        }
+    }
+
+    #[test]
+    fn econ_vector_growth_then_shrink_drops_history() {
+        let mut entity = entity(1);
+        apply_length(&mut entity, 3);
+        for index in 0..3 {
+            put_slot(&mut entity, index, 100 + index, index as f32);
+        }
+        apply_length(&mut entity, 11);
+        for index in 3..11 {
+            put_slot(&mut entity, index, 100 + index, index as f32);
+        }
+
+        apply_length(&mut entity, 3);
+
+        for index in 3..11 {
+            assert_slot_absent(&entity, index);
+        }
+    }
+
+    #[test]
+    fn econ_vector_length_change_invalidates_cosmetic_revision() {
+        let mut entity = entity(1);
+        apply_length(&mut entity, 11);
+        for index in 0..11 {
+            put_slot(&mut entity, index, 100 + index, index as f32);
+        }
+        let cached_revision = entity.cosmetic_revision;
+
+        apply_length(&mut entity, 3);
+
+        assert_ne!(entity.cosmetic_revision, cached_revision);
+        for index in 3..11 {
+            assert_slot_absent(&entity, index);
+        }
+    }
+
+    #[test]
+    fn econ_vector_lengths_are_isolated_between_entities() {
+        let mut item_a = entity(1);
+        let mut item_b = entity(2);
+        for item in [&mut item_a, &mut item_b] {
+            apply_length(item, 11);
+            for index in 0..11 {
+                put_slot(item, index, 100 + index, index as f32);
+            }
+        }
+
+        apply_length(&mut item_b, 3);
+
+        assert_eq!(item_a.weapon_econ_attribute_length(), Some(11));
+        assert_eq!(item_b.weapon_econ_attribute_length(), Some(3));
+        for index in 3..11 {
+            assert!(item_a.props.contains_key(&(WEAPON_ATTRIBUTE_DEF_INDEX_ID + index)));
+            assert_slot_absent(&item_b, index);
+        }
+    }
+}
