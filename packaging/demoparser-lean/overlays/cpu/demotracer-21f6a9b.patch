+    fn field(tag: u64, value: &[u8], out: &mut Vec<u8>) {
+        write_delta_varint((tag << 3) | 2, out);
+        write_delta_varint(value.len() as u64, out);
+        out.extend_from_slice(value);
+    }
+
+    fn reset(tag: u64, out: &mut Vec<u8>) {
+        write_delta_varint((tag << 3) | 7, out);
+    }
