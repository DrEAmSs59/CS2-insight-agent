diff --git a/src/parser/src/profile.rs b/src/parser/src/profile.rs
new file mode 100644
index 00000000..8f5e5e06
--- /dev/null
+++ b/src/parser/src/profile.rs
@@ -0,0 +1,190 @@
+//! Opt-in aggregate parser diagnostics. No timers or allocations in the hot
+//! path unless a DEMOTRACER_PROFILE flag is enabled in the environment.
+use crate::first_pass::prop_controller::PropInfo;
+use std::time::{Duration, Instant};
+
+#[derive(Default)]
+pub(crate) struct PassProfile {
+    enabled: bool,
+    frames: u64,
+    skipped_frames: u64,
+    compressed_frames: u64,
+    compressed_bytes: u64,
+    decompressed_bytes: u64,
+    decompression: Duration,
+    entity_messages: u64,
+    entity_parse: Duration,
+    entity_collect: Duration,
+    phases: [Duration; 8],
+    phase_calls: [u64; 8],
+}
+
+impl PassProfile {
+    pub(crate) fn new() -> Self {
+        Self {
+            enabled: std::env::var_os("DEMOTRACER_PROFILE").is_some(),
+            ..Self::default()
+        }
+    }
+
+    #[inline]
+    pub(crate) fn start(&self) -> Option<Instant> {
+        self.enabled.then(Instant::now)
+    }
+
+    #[inline]
+    pub(crate) fn phase(&mut self, phase: usize, started: Option<Instant>) {
+        if let Some(started) = started {
+            self.phases[phase] += started.elapsed();
+            self.phase_calls[phase] += 1;
+        }
+    }
+
+    #[inline]
+    pub(crate) fn frame(&mut self, skipped: bool) {
+        if self.enabled {
+            self.frames += 1;
+            self.skipped_frames += u64::from(skipped);
+        }
+    }
+
+    #[inline]
+    pub(crate) fn decompressed(&mut self, started: Option<Instant>, input: usize, output: usize) {
+        if let Some(started) = started {
+            self.decompression += started.elapsed();
+            self.compressed_frames += 1;
+            self.compressed_bytes += input as u64;
+            self.decompressed_bytes += output as u64;
+        }
+    }
+
+    #[inline]
+    pub(crate) fn parsed_entities(&mut self, started: Option<Instant>) {
+        if let Some(started) = started {
+            self.entity_messages += 1;
+            self.entity_parse += started.elapsed();
+        }
+    }
+
+    #[inline]
+    pub(crate) fn collected_entities(&mut self, started: Option<Instant>) {
+        if let Some(started) = started {
+            self.entity_collect += started.elapsed();
+        }
+    }
+
+    pub(crate) fn report(&self, pass: &str, offset: usize, started: Option<Instant>) {
+        if let Some(started) = started {
+            eprintln!(
+                "[demotracer-profile] pass={pass} offset={offset} loop_ms={:.3} frames={} skipped_frames={} snappy_frames={} snappy_input_bytes={} snappy_output_bytes={} snappy_ms={:.3} entity_messages={} entity_parse_ms={:.3} entity_collect_ms={:.3}",
+                started.elapsed().as_secs_f64() * 1000.0,
+                self.frames,
+                self.skipped_frames,
+                self.compressed_frames,
+                self.compressed_bytes,
+                self.decompressed_bytes,
+                self.decompression.as_secs_f64() * 1000.0,
+                self.entity_messages,
+                self.entity_parse.as_secs_f64() * 1000.0,
+                self.entity_collect.as_secs_f64() * 1000.0,
+            );
+            for (phase, name) in ["packet_envelope", "message_copy", "usercmd", "other_messages", "delta_decode", "full_decode", "full_apply", "delta_apply"].iter().enumerate() {
+                eprintln!("[demotracer-profile] pass={pass} phase={name} calls={} ms={:.3}",
+                    self.phase_calls[phase], self.phases[phase].as_secs_f64() * 1000.0);
+            }
+        }
+    }
+}
+
+#[derive(Clone, Default)]
+struct PropertyTiming {
+    calls: u64,
+    elapsed: Duration,
+}
+
+/// Sample only the non-deferred getter and column append work. The caller
+/// selects an instrumented row loop so disabled profiling adds no cell checks.
+pub(crate) struct PropertyProfile {
+    rows: u64,
+    sampled_rows: u64,
+    deferred_columns: usize,
+    timings: Vec<PropertyTiming>,
+}
+
+impl PropertyProfile {
+    pub(crate) fn from_env(columns: usize, deferred_columns: usize) -> Option<Self> {
+        (std::env::var("DEMOTRACER_PROFILE_PROPERTIES").as_deref() == Ok("1"))
+            .then(|| Self::new(columns, deferred_columns))
+    }
+
+    fn new(columns: usize, deferred_columns: usize) -> Self {
+        Self { rows: 0, sampled_rows: 0, deferred_columns, timings: vec![PropertyTiming::default(); columns] }
+    }
+
+    pub(crate) fn sample_row(&mut self) -> bool {
+        let row = self.rows;
+        self.rows += 1;
+        // Exactly one sample in each 256-row block. Rotating the position
+        // avoids always sampling the same half of a ten-player roster.
+        let sample = row % 256 == (row / 256).wrapping_mul(73) % 256;
+        self.sampled_rows += u64::from(sample);
+        sample
+    }
+
+    pub(crate) fn record(&mut self, slot: usize, started: Instant) {
+        let elapsed = started.elapsed();
+        self.timings[slot].calls += 1;
+        self.timings[slot].elapsed += elapsed;
+    }
+
+    pub(crate) fn report(&self, props: &[PropInfo]) {
+        let mut slots: Vec<_> = (0..self.timings.len()).collect();
+        slots.sort_unstable_by(|&left, &right| {
+            self.timings[right].elapsed.cmp(&self.timings[left].elapsed).then(left.cmp(&right))
+        });
+        let measured_columns = self.timings.iter().filter(|timing| timing.calls != 0).count();
+        let sampled_ms: f64 = self.timings.iter().map(|timing| timing.elapsed.as_secs_f64() * 1000.0).sum();
+        eprintln!(
+            "[demotracer-properties] rows={} sampled_rows={} sample_rate=1/256 measured_columns={} deferred_columns={} deferred_cell_samples=0 sampled_get_push_ms={:.3}",
+            self.rows, self.sampled_rows, measured_columns, self.deferred_columns, sampled_ms,
+        );
+        for slot in slots.into_iter().take(15) {
+            let timing = &self.timings[slot];
+            let elapsed_us = timing.elapsed.as_secs_f64() * 1_000_000.0;
+            eprintln!(
+                "[demotracer-properties] property={:?} id={} samples={} sampled_ms={:.3} mean_us={:.3}",
+                props[slot].prop_friendly_name, props[slot].id, timing.calls,
+                elapsed_us / 1000.0,
+                if timing.calls == 0 { 0.0 } else { elapsed_us / timing.calls as f64 },
+            );
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn property_sampling_has_one_sample_per_block_and_rotates_roster_slots() {
+        let mut profile = PropertyProfile::new(3, 1);
+        let mut player_slots = [false; 10];
+        for block in 0..256 {
+            let mut samples = 0;
+            for offset in 0..256 {
+                if profile.sample_row() {
+                    samples += 1;
+                    player_slots[(block * 256 + offset) % 10] = true;
+                    profile.record(0, Instant::now());
+                }
+            }
+            assert_eq!(samples, 1);
+        }
+        assert!(player_slots.iter().all(|sampled| *sampled));
+        assert_eq!(profile.rows, 65_536);
+        assert_eq!(profile.sampled_rows, 256);
+        assert_eq!(profile.timings[0].calls, 256);
+        assert_eq!(profile.timings[1].calls, 0);
+        assert_eq!(profile.timings[2].calls, 0);
+    }
+}
diff --git a/src/parser/src/row_channels.rs b/src/parser/src/row_channels.rs
new file mode 100644
index 00000000..3c13db1c
--- /dev/null
+++ b/src/parser/src/row_channels.rs
@@ -0,0 +1,107 @@
+//! Insight row-only callers. Both channels share the same schema/ID assignment.
+use crate::first_pass::parser::FirstPassOutput;
+use crate::first_pass::parser_settings::{check_multithreadability, rm_user_friendly_names, FirstPassParser};
+use crate::first_pass::prop_controller::{ENTITY_ID_ID, STEAMID_ID, TICK_ID};
+use crate::first_pass::read_bits::DemoParserError;
+use crate::parse_demo::{DecodePlan, DemoOutput, Parser, ParsingMode};
+use crate::second_pass::variants::{PropColumn, VarVec};
+use ahash::AHashSet;
+
+fn same_key(left: Option<&PropColumn>, right: Option<&PropColumn>, rows: usize) -> bool {
+    match (left.and_then(|c| c.data.as_ref()), right.and_then(|c| c.data.as_ref())) {
+        (Some(VarVec::I32(a)), Some(VarVec::I32(b))) => a.len() == rows && a == b && a.iter().all(Option::is_some),
+        (Some(VarVec::U32(a)), Some(VarVec::U32(b))) => a.len() == rows && a == b && a.iter().all(Option::is_some),
+        (Some(VarVec::U64(a)), Some(VarVec::U64(b))) => a.len() == rows && a == b && a.iter().all(Option::is_some),
+        _ => false,
+    }
+}
+
+impl<'a> Parser<'a> {
+    pub fn parse_player_rows(&mut self, bytes: &[u8]) -> Result<DemoOutput, DemoParserError> {
+        if !self.input.wanted_events.is_empty() || !self.input.wanted_other_props.is_empty()
+            || self.input.collect_projectile_records || self.input.parse_projectiles || self.input.parse_infernos || self.input.parse_grenades
+            || self.input.order_by_steamid || self.input.list_props || self.input.only_convars
+            || !self.input.wanted_prop_states.is_empty() || !self.input.parse_ents
+            || self.input.fallback_bytes.is_some()
+        { return self.parse_demo(bytes); }
+        self.decode_plan = DecodePlan { project_entity_state: true, all_player_rows: false, ..DecodePlan::PLAYER_ROWS_ONLY };
+        if check_multithreadability(&self.input.wanted_player_props)
+            && !self.input.wanted_player_props.iter().any(|p| p.starts_with("usercmd_")) {
+            return self.parse_demo(bytes);
+        }
+        if let Some(result) = self.try_row_channels(bytes)? { return Ok(result); }
+        self.decode_plan = DecodePlan::FULL;
+        self.parsing_mode = ParsingMode::ForceSingleThreaded;
+        self.parse_demo(bytes)
+    }
+
+    fn try_row_channels(&self, bytes: &[u8]) -> Result<Option<DemoOutput>, DemoParserError> {
+        let mut settings = self.input.clone();
+        let round = rm_user_friendly_names(&vec!["total_rounds_played".into()])?.remove(0);
+        let mut added = AHashSet::default();
+        for prop in ["entity_id".to_string(), round.clone()] {
+            if !settings.wanted_player_props.contains(&prop) {
+                added.insert(prop.clone());
+                settings.wanted_player_props.push(prop.clone());
+                settings.real_name_to_og_name.insert(prop.clone(), prop);
+            }
+        }
+        let mut first = FirstPassParser::new(&settings);
+        let full = first.parse_demo(bytes, false)?;
+        if full.prop_controller.event_with_velocity { return Ok(None); }
+        let mut ids = AHashSet::default();
+        for info in &full.prop_controller.prop_infos {
+            if !ids.insert(info.id) { return Ok(None); }
+        }
+        let Some(round_id) = full.prop_controller.prop_infos.iter().find(|p| p.prop_name == round).map(|p| p.id) else { return Ok(None); };
+        let keys = [TICK_ID, ENTITY_ID_ID, STEAMID_ID, round_id];
+        let is_sequential = |name: &str| name.starts_with("usercmd_") || !check_multithreadability(&[name.to_owned()]);
+        let sequential_ids: AHashSet<_> = full.prop_controller.prop_infos.iter()
+            .filter(|p| is_sequential(&p.prop_name)).map(|p| p.id).collect();
+        let mut primary_props = full.prop_controller.clone();
+        primary_props.prop_infos.retain(|p| !sequential_ids.contains(&p.id) || keys.contains(&p.id));
+        let mut sequential_props = full.prop_controller.clone();
+        sequential_props.prop_infos.retain(|p| sequential_ids.contains(&p.id) || keys.contains(&p.id));
+        let mut primary_settings = settings.clone();
+        primary_settings.wanted_player_props.retain(|p| !is_sequential(p));
+        let mut sequential_settings = settings.clone();
+        sequential_settings.wanted_player_props.retain(|p| is_sequential(p) || p == "entity_id" || p == &round);
+        if !check_multithreadability(&primary_settings.wanted_player_props) { return Ok(None); }
+        let primary = FirstPassOutput { prop_controller: &primary_props, settings: &primary_settings, ..full.clone() };
+        let sequential = FirstPassOutput { prop_controller: &sequential_props, settings: &sequential_settings, ..full.clone() };
+        let primary_parser = Parser::new_with_decode_plan(primary_settings.clone(), ParsingMode::ForceMultiThreaded, self.decode_plan);
+        let sequential_parser = Parser::new_with_decode_plan(sequential_settings.clone(), ParsingMode::ForceSingleThreaded, self.decode_plan);
+        let (primary, sequential) = rayon::join(
+            || primary_parser.second_pass_multi_threaded(bytes, primary, false),
+            || sequential_parser.second_pass_single_threaded(bytes, sequential, false),
+        );
+        let (Ok(mut primary), Ok(mut sequential)) = (primary, sequential) else { return Ok(None); };
+        let rows = primary.df.get(&TICK_ID).map_or(0, PropColumn::len);
+        if rows == 0 || !keys.iter().all(|id| same_key(primary.df.get(id), sequential.df.get(id), rows))
+            || !sequential_ids.iter().all(|id| sequential.df.get(id).is_some_and(|c| c.len() == rows))
+        { return Ok(None); }
+        for id in sequential_ids { primary.df.insert(id, sequential.df.remove(&id).unwrap()); }
+        primary.prop_controller = full.prop_controller.clone();
+        primary.prop_controller.prop_infos.retain(|p| !added.contains(&p.prop_name));
+        let retained: AHashSet<_> = primary.prop_controller.prop_infos.iter().map(|p| p.id).collect();
+        primary.df.retain(|id, _| retained.contains(id));
+        Ok(Some(primary))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn column(values: Vec<Option<i32>>) -> PropColumn { PropColumn { data: Some(VarVec::I32(values)), num_nones: 0 } }
+    #[test]
+    fn alignment_rejects_order_null_length_and_type_mismatches() {
+        let a = column(vec![Some(1), Some(2)]);
+        assert!(same_key(Some(&a), Some(&a), 2));
+        for b in [column(vec![Some(2), Some(1)]), column(vec![Some(1), None]), column(vec![Some(1)])] {
+            assert!(!same_key(Some(&a), Some(&b), 2));
+        }
+        assert!(!same_key(None, None, 0));
+        let b = PropColumn { data: Some(VarVec::U32(vec![Some(1), Some(2)])), num_nones: 0 };
+        assert!(!same_key(Some(&a), Some(&b), 2));
+    }
+}
