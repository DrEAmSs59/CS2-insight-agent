{
  "name": "cs2-insight-agent",
  "private": true,
  "version": "2.6.0",
  "packageManager": "pnpm@12.14.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:cs2-catalog": "node scripts/generate-cs2-item-catalog.mjs",
    "build": "pnpm run generate:cs2-catalog && vite build",
    "preview": "vite preview",
    "desktop:dev": "tauri dev",
    "desktop:check": "pnpm run generate:cs2-catalog && vite build && cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "desktop:stage-python": "node scripts/stage-python-runtime.mjs",
    "desktop:stage-resources": "node scripts/stage-tauri-resources.mjs",
    "desktop:build": "pnpm run generate:cs2-catalog && pnpm run desktop:stage-python && pnpm run desktop:stage-resources && tauri build",
    "desktop:build:ver": "node scripts/tauri-build-version.mjs",
    "deploy:r2": "node scripts/deploy-r2.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@radix-ui/colors": "3.0.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1154.0",
    "@aws-sdk/lib-storage": "3.1154.0",
    "@ianlucas/cs2-lib": "9.8.0",
    "@ianlucas/cs2-lib-inspect": "9.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "axios": "^1.20.0",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.15"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  }
}
